+private:
+    static inline std::string trim(const std::string& s)
+    {
+        std::size_t b = 0;
+        std::size_t e = s.size();
+        while (b < e && std::isspace(static_cast<unsigned char>(s[b]))) {
+            ++b;
+        }
+        while (e > b && std::isspace(static_cast<unsigned char>(s[e - 1]))) {
+            --e;
+        }
+        return s.substr(b, e - b);
+    }
+
+    // Keyboard condition syntax:
+    //   key(1).on_pressed
+    //   key(2).pressed
+    //   key(1)
+    static inline std::function<bool()> make_keyboard_check(const std::string& raw_condition)
+    {
+        const std::string condition = trim(raw_condition);
+        if (condition.rfind("key(", 0) != 0) {
+            return {};
+        }
+
+        const std::size_t close_pos = condition.find(')');
+        if (close_pos == std::string::npos || close_pos <= 4) {
+            throw std::runtime_error("Invalid keyboard transition syntax: " + condition);
+        }
+        const std::string key_name = condition.substr(4, close_pos - 4);
+
+        std::string suffix;
+        if (close_pos + 1 < condition.size()) {
+            suffix = condition.substr(close_pos + 1);
+        }
+        suffix = trim(suffix);
+        if (suffix.empty()) {
+            suffix = ".on_pressed";
+        }
+
+        if (suffix == ".pressed") {
+            return [key_name]() -> bool {
+                return FSMState::keyboard && FSMState::keyboard->key() == key_name;
+            };
+        }
+        if (suffix == ".on_pressed") {
+            return [key_name]() -> bool {
+                return FSMState::keyboard &&
+                       FSMState::keyboard->on_pressed &&
+                       FSMState::keyboard->key() == key_name;
+            };
+        }
+
+        throw std::runtime_error("Unsupported keyboard transition suffix: " + suffix);
+    }
+};
