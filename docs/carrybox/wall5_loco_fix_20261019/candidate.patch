+        s.standing_start = torch.zeros(env.num_envs, device=env.device, dtype=torch.bool)
+    stationary = (s.skills[ids] == 0) & (torch.rand(len(ids), device=env.device) >= loco_reference_fraction(env))
+    s.standing_start[ids] = stationary
