+    effective = 0 if curriculum.anchor is None else max(0, curriculum.iteration - curriculum.anchor)
+    return max(0., min(1., (effective - env.cfg.loco_standing_warmup_iterations)
+                          / env.cfg.loco_reference_ramp_iterations))
